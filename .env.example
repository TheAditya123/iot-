# Physical HC-SR501 PIR. BCM GPIO 17 is physical header pin 11.
# AWS identity/endpoint/certificates live separately in .env.aws.
DEVICE_ID=room-monitor-pi
PIR_GPIO=17
PIR_WARMUP_SECONDS=60
PIR_COOLDOWN_SECONDS=5
DATA_PATH=data/events.json

# Raspberry Pi Camera Module 3 on a Pi 5 CSI connector.
CAMERA_BACKEND=pi
WEBCAM_INDEX=0
IMAGE_DIR=images

# Optional physical BME280 on I2C bus 1. Use auto to probe 0x76 and 0x77.
ENV_SENSOR_ENABLED=false
BME280_I2C_BUS=1
BME280_ADDRESS=auto

# Download the pinned OpenCV Zoo NanoDet model with scripts/download_model.py.
INFERENCE_BACKEND=off
MODEL_PATH=models/object_detection_nanodet_2022nov.onnx
PERSON_CONFIDENCE_THRESHOLD=0.5

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
