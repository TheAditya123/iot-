# Physical HC-SR501 PIR. BCM GPIO 17 is physical header pin 11.
# AWS identity/endpoint/certificates live separately in .env.aws.
DEVICE_ID=room-monitor-pi
PIR_GPIO=17
PIR_WARMUP_SECONDS=60
PIR_COOLDOWN_SECONDS=5
DATA_PATH=data/events.json

# Add a real camera later by changing off to pi or webcam.
CAMERA_BACKEND=off
WEBCAM_INDEX=0
IMAGE_DIR=images

# Only enable TFLite after supplying a compatible model and labels.
INFERENCE_BACKEND=off
MODEL_PATH=models/model.tflite
LABELS_PATH=models/labels.txt
MODEL_INPUT_MEAN=0
MODEL_INPUT_STD=255
MODEL_OUTPUT_LOGITS=false
