# Deferred hardware app settings. For the current MQTT setup, use .env.mqtt.example.
DEVICE_ID=room-monitor-pi
PIR_BACKEND=simulated
PIR_INTERVAL_SECONDS=5
PIR_GPIO=17
CAMERA_BACKEND=simulated
WEBCAM_INDEX=0
INFERENCE_BACKEND=stub
MODEL_PATH=models/model.tflite
LABELS_PATH=models/labels.txt
# Model real-valued input = (RGB pixel - mean) / std, before quantization.
MODEL_INPUT_MEAN=0
MODEL_INPUT_STD=255
# Set true only for models whose output is logits.
MODEL_OUTPUT_LOGITS=false
DATA_PATH=data/events.json
IMAGE_DIR=images
SAVE_IMAGES=true
MQTT_ENABLED=false
MQTT_ENDPOINT=
MQTT_PORT=8883
MQTT_TOPIC=iot/room/events
MQTT_CA_CERT=certs/AmazonRootCA1.pem
MQTT_CLIENT_CERT=certs/device.cert.pem
MQTT_PRIVATE_KEY=certs/device.private.key
MQTT_TIMEOUT_SECONDS=10
