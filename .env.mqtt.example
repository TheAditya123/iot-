# The bootstrap writes these settings to .env.aws automatically.
# For certificates created manually in AWS Console, copy this to .env.aws and edit.
DEVICE_ID=room-monitor-pi
# Optional when an AWS wizard policy allows a client ID different from the Thing name.
MQTT_CLIENT_ID=
MQTT_ENDPOINT=
MQTT_PORT=8883
MQTT_TEST_TOPIC=iot/setup/test
MQTT_TOPIC=iot/room/events
MQTT_CA_CERT=certs/AmazonRootCA1.pem
MQTT_CLIENT_CERT=certs/device.cert.pem
MQTT_PRIVATE_KEY=certs/device.private.key
